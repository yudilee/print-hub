<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_print_hub_print_wizard_form" model="ir.ui.view">
        <field name="name">print.hub.print.wizard.form</field>
        <field name="model">print.hub.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Cetak Langsung ke Print Hub">
                <sheet>
                    <div class="oe_title">
                        <label for="record_name" string="Target Dokumen"/>
                        <h3>
                            <field name="record_name" readonly="1" class="text-primary"/>
                        </h3>
                    </div>

                    <group>
                        <group string="Konfigurasi Cetak">
                            <field name="model_name" invisible="1"/>
                            <field name="res_ids_str" invisible="1"/>
                            <field name="report_domain" invisible="1"/>
                            <field name="has_preview" invisible="1"/>

                            <field name="report_id"
                                   domain="[('model', '=', model_name), ('report_type', 'in', ['qweb-pdf', 'qweb-text'])]"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="branch_id" readonly="1" options="{'no_open': True}"/>
                            <field name="copies"/>
                            <field name="custom_watermark"/>
                        </group>

                        <group string="Tujuan Printer (Print Hub)">
                            <field name="printer_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="printer_status" widget="badge"
                                   decoration-success="printer_status == 'online'"
                                   decoration-danger="printer_status == 'offline'"
                                   invisible="not printer_id"/>
                            <field name="queue_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>

                    <notebook invisible="not has_preview">
                        <page string="👁️ Pratinjau PDF Dokumen" name="preview_page">
                            <div class="mt-2 mb-2">
                                <field name="preview_pdf" widget="pdf_viewer" filename="preview_filename"/>
                            </div>
                        </page>
                    </notebook>
                </sheet>

                <footer>
                    <button name="action_print" string="🖨️ Cetak Sekarang" type="object" class="btn-primary"/>
                    <button name="action_preview" string="👁️ Pratinjau (Preview)" type="object" class="btn-secondary"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for Generic Print Wizard -->
    <record id="action_print_hub_print_wizard" model="ir.actions.act_window">
        <field name="name">🖨️ Cetak ke Print Hub</field>
        <field name="res_model">print.hub.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_ir_actions_actions"/>
    </record>

</odoo>
