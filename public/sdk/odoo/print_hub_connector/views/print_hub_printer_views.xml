<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_print_hub_printer_tree" model="ir.ui.view">
        <field name="name">print.hub.printer.tree</field>
        <field name="model">print.hub.printer</field>
        <field name="arch" type="xml">
            <tree string="Physical Printers &amp; Agents" create="false"
                  decoration-success="status == 'online' and paper_status == 'ok'"
                  decoration-danger="status == 'offline' or paper_status in ('out', 'jammed')"
                  decoration-warning="paper_status == 'low' or status == 'paused'">
                <field name="name"/>
                <field name="agent_name"/>
                <field name="branch_code"/>
                <field name="branch_name"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'online'"
                       decoration-danger="status == 'offline'"
                       decoration-warning="status == 'paused'"/>
                <field name="paper_status" widget="badge"
                       decoration-success="paper_status == 'ok'"
                       decoration-danger="paper_status in ('out', 'jammed')"
                       decoration-warning="paper_status == 'low'"/>
                <field name="is_default" widget="boolean_toggle" readonly="1"/>
                <field name="last_synced_at"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_print_hub_printer_form" model="ir.ui.view">
        <field name="name">print.hub.printer.form</field>
        <field name="model">print.hub.printer</field>
        <field name="arch" type="xml">
            <form string="Printer Health" create="false">
                <header>
                    <button name="action_sync_printers" string="🔄 Sync Live Health from Hub" type="object" class="btn-primary"/>
                    <field name="status" widget="statusbar" statusbar_visible="online,offline,paused,error"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="paper_status not in ('out', 'jammed') and status != 'offline'">
                        <strong>Warning:</strong> Printer is unavailable or out of paper.
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Printer Name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Workstation &amp; Location">
                            <field name="agent_name" readonly="1"/>
                            <field name="agent_id" readonly="1"/>
                            <field name="branch_code" readonly="1"/>
                            <field name="branch_name" readonly="1"/>
                            <field name="is_default" readonly="1"/>
                        </group>
                        <group string="Live Telemetry">
                            <field name="agent_online" readonly="1" widget="boolean"/>
                            <field name="paper_status" readonly="1" widget="badge"
                                   decoration-success="paper_status == 'ok'"
                                   decoration-danger="paper_status in ('out', 'jammed')"
                                   decoration-warning="paper_status == 'low'"/>
                            <field name="last_synced_at" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_print_hub_printer_search" model="ir.ui.view">
        <field name="name">print.hub.printer.search</field>
        <field name="model">print.hub.printer</field>
        <field name="arch" type="xml">
            <search string="Search Printers">
                <field name="name"/>
                <field name="agent_name"/>
                <field name="branch_code"/>
                <separator/>
                <filter string="Online &amp; Ready" name="online_ready" domain="[('status', '=', 'online'), ('paper_status', '=', 'ok')]"/>
                <filter string="Paper Out / Jammed" name="paper_issues" domain="[('paper_status', 'in', ['out', 'jammed'])]"/>
                <filter string="Offline" name="offline" domain="[('status', '=', 'offline')]"/>
                <group expand="0" string="Group By">
                    <filter string="Branch" name="group_branch" context="{'group_by': 'branch_code'}"/>
                    <filter string="Agent" name="group_agent" context="{'group_by': 'agent_name'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Paper Status" name="group_paper" context="{'group_by': 'paper_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_print_hub_printers" model="ir.actions.act_window">
        <field name="name">Printers &amp; Health</field>
        <field name="res_model">print.hub.printer</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_print_hub_printer_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No physical printers synced yet.
            </p>
            <p>
                Click <b>"Sync Live Health from Hub"</b> or configure your Print Hub connection to discover branch printers and agents.
            </p>
        </field>
    </record>

</odoo>
