<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_print_hub_rule_tree" model="ir.ui.view">
        <field name="name">print.hub.rule.tree</field>
        <field name="model">print.hub.rule</field>
        <field name="arch" type="xml">
            <list string="Print Routing Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="routing_type"/>
                <field name="report_id"/>
                <field name="template_slug"/>
                <field name="branch_code"/>
                <field name="pool_id"/>
                <field name="queue_id"/>
                <field name="printer_id"/>
                <field name="watermark_rule"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_print_hub_rule_form" model="ir.ui.view">
        <field name="name">print.hub.rule.form</field>
        <field name="model">print.hub.rule</field>
        <field name="arch" type="xml">
            <form string="Print Routing Rule">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Rule Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Surat Jalan -> Dot Matrix Warehouse Pool"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Print Engine &amp; Document Matching">
                            <field name="routing_type" widget="radio"/>
                            <field name="report_id" invisible="routing_type != 'qweb_pdf'" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="report_technical_name" invisible="routing_type != 'qweb_pdf'"/>
                            <field name="template_slug" invisible="routing_type != 'template_json'"
                                   placeholder="e.g. odoo_surat_jalan_continuous"/>
                            <field name="branch_id" options="{'no_create': True}"/>
                            <field name="branch_code" placeholder="Leave empty for all branches"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Destination &amp; Failover (From Print Hub)">
                            <field name="pool_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                   placeholder="Select printer pool configured in Print Hub..."/>
                            <field name="queue_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                   placeholder="Select queue/profile configured in Print Hub..."/>
                            <field name="printer_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                   placeholder="Select physical printer discovered in Print Hub..."/>
                            <field name="copies"/>
                        </group>
                    </group>
                    <group string="Dynamic Watermarking">
                        <group>
                            <field name="watermark_rule"/>
                            <field name="watermark_text" invisible="watermark_rule != 'custom'"/>
                            <field name="watermark_opacity" invisible="watermark_rule == 'none'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description &amp; Notes">
                            <field name="notes" placeholder="Add operational notes or tray specifications here..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_print_hub_rule" model="ir.actions.act_window">
        <field name="name">Document Routing Rules</field>
        <field name="res_model">print.hub.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an automated print routing rule
            </p>
            <p>
                Configure which reports route to which Print Hub queues, pools, or physical printers.
            </p>
        </field>
    </record>

</odoo>
