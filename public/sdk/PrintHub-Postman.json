{
  "info": {
    "name": "Print Hub API",
    "description": "Complete API collection for Print Hub print management middleware. Import this collection, then set `base_url` and `api_key` variables in Postman's Variables tab.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://print-hub.example.com/api/v1" },
    { "key": "api_key", "value": "your-api-key-here" },
    { "key": "job_id", "value": "" },
    { "key": "template_name", "value": "invoice_sewa" },
    { "key": "branch_code", "value": "SDP-MAIN" },
    { "key": "document_id", "value": "" },
    { "key": "pool_id", "value": "" },
    { "key": "schema_name", "value": "invoice_sewa" },
    { "key": "connector_id", "value": "" },
    { "key": "approval_id", "value": "" }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-API-Key", "type": "string" },
      { "key": "value", "value": "{{api_key}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Connection & Health",
      "item": [
        {
          "name": "Test Connection",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/test"
          }
        },
        {
          "name": "System Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        }
      ]
    },
    {
      "name": "Discovery",
      "item": [
        {
          "name": "List Branches",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/branches"
          }
        },
        {
          "name": "List Online Agents",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/agents/online?branch_code={{branch_code}}",
              "query": [
                { "key": "branch_code", "value": "{{branch_code}}" }
              ]
            }
          }
        },
        {
          "name": "List Queues",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/queues?branch_code={{branch_code}}&detailed=true",
              "query": [
                { "key": "branch_code", "value": "{{branch_code}}" },
                { "key": "detailed", "value": "true" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Templates",
      "item": [
        {
          "name": "List Templates",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/templates"
          }
        },
        {
          "name": "Get Template Details",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/templates/{{template_name}}"
          }
        },
        {
          "name": "Get Template Schema",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/templates/{{template_name}}/schema"
          }
        },
        {
          "name": "Validate Template Data",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"data\": {\n        \"no_invoice\": \"INV-001\",\n        \"customer\": \"PT Example\",\n        \"total\": 150000\n    }\n}"
            },
            "url": "{{base_url}}/templates/{{template_name}}/validate"
          }
        }
      ]
    },
    {
      "name": "Data Schemas",
      "item": [
        {
          "name": "Register Schema",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"schema_name\": \"invoice_sewa\",\n    \"label\": \"Sewa Invoice\",\n    \"fields\": {\n        \"no_invoice\": { \"label\": \"Invoice No\", \"type\": \"string\", \"required\": true },\n        \"customer\": { \"label\": \"Customer\", \"type\": \"string\", \"required\": true },\n        \"total\": { \"label\": \"Total\", \"type\": \"number\", \"required\": true }\n    },\n    \"tables\": {\n        \"items\": {\n            \"label\": \"Items\",\n            \"columns\": {\n                \"description\": { \"label\": \"Description\", \"type\": \"string\" },\n                \"qty\": { \"label\": \"Qty\", \"type\": \"number\" },\n                \"price\": { \"label\": \"Price\", \"type\": \"number\" }\n            }\n        }\n    }\n}"
            },
            "url": "{{base_url}}/schema"
          }
        },
        {
          "name": "List Schemas",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/schemas"
          }
        },
        {
          "name": "Schema Version History",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/schema/{{schema_name}}/versions"
          }
        },
        {
          "name": "Schema Version Diff",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/schema/{{schema_name}}/diff?from_version=1&to_version=2",
              "query": [
                { "key": "from_version", "value": "1" },
                { "key": "to_version", "value": "2" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Printing",
      "item": [
        {
          "name": "Submit Print Job (Template)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"template\": \"{{template_name}}\",\n    \"data\": {\n        \"no_invoice\": \"INV-001\",\n        \"customer\": \"PT Example\",\n        \"total\": 150000\n    },\n    \"branch_code\": \"{{branch_code}}\",\n    \"reference_id\": \"INV-001\",\n    \"options\": {\n        \"copies\": 1\n    },\n    \"pool_id\": {{pool_id}},\n    \"priority\": 0,\n    \"type\": \"normal\"\n}"
            },
            "url": "{{base_url}}/print"
          }
        },
        {
          "name": "Submit Print Job (Scheduled)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"template\": \"{{template_name}}\",\n    \"data\": {\n        \"no_invoice\": \"INV-001\",\n        \"customer\": \"PT Example\",\n        \"total\": 150000\n    },\n    \"branch_code\": \"{{branch_code}}\",\n    \"reference_id\": \"INV-001\",\n    \"options\": {\n        \"copies\": 1\n    },\n    \"scheduled_at\": \"2026-05-08 08:00:00\",\n    \"recurrence\": \"daily\",\n    \"recurrence_count\": 5\n}"
            },
            "url": "{{base_url}}/print"
          }
        },
        {
          "name": "Submit Print Job (Raw PDF)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"document_base64\": \"JVBERi0xLjcNC... (base64-encoded PDF)\",\n    \"reference_id\": \"DOC-001\",\n    \"branch_code\": \"{{branch_code}}\",\n    \"options\": {\n        \"copies\": 2\n    },\n    \"pool_id\": {{pool_id}}\n}"
            },
            "url": "{{base_url}}/print/base64"
          }
        },
        {
          "name": "Submit Print Job (Document ID)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"document_id\": {{document_id}},\n    \"reference_id\": \"DOC-001\",\n    \"branch_code\": \"{{branch_code}}\",\n    \"options\": {\n        \"copies\": 1\n    }\n}"
            },
            "url": "{{base_url}}/print"
          }
        },
        {
          "name": "Batch Print",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"jobs\": [\n        {\n            \"template\": \"{{template_name}}\",\n            \"data\": { \"no_invoice\": \"INV-001\", \"customer\": \"PT ABC\", \"total\": 150000 },\n            \"reference_id\": \"INV-001\"\n        },\n        {\n            \"template\": \"{{template_name}}\",\n            \"data\": { \"no_invoice\": \"INV-002\", \"customer\": \"PT XYZ\", \"total\": 200000 },\n            \"reference_id\": \"INV-002\"\n        }\n    ]\n}"
            },
            "url": "{{base_url}}/print/batch"
          }
        },
        {
          "name": "Preview PDF",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"template\": \"{{template_name}}\",\n    \"data\": {\n        \"no_invoice\": \"INV-001\",\n        \"customer\": \"PT Example\",\n        \"total\": 150000\n    }\n}"
            },
            "url": "{{base_url}}/preview"
          }
        }
      ]
    },
    {
      "name": "Job Management",
      "item": [
        {
          "name": "Check Job Status",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/jobs/{{job_id}}"
          }
        },
        {
          "name": "Cancel Job",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/jobs/{{job_id}}"
          }
        }
      ]
    },
    {
      "name": "Approvals",
      "item": [
        {
          "name": "Get Pending Approvals",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/approvals/pending"
          }
        },
        {
          "name": "Approve Job",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"notes\": \"Approved by manager\"\n}"
            },
            "url": "{{base_url}}/approvals/{{approval_id}}/approve"
          }
        },
        {
          "name": "Reject Job",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"reason\": \"Incorrect data format\"\n}"
            },
            "url": "{{base_url}}/approvals/{{approval_id}}/reject"
          }
        }
      ]
    },
    {
      "name": "Document Management",
      "item": [
        {
          "name": "Upload Document",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "multipart/form-data" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" },
                { "key": "label", "value": "Invoice Document" }
              ]
            },
            "url": "{{base_url}}/documents/upload"
          }
        },
        {
          "name": "List Documents",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/documents"
          }
        },
        {
          "name": "Get Document",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/documents/{{document_id}}"
          }
        },
        {
          "name": "Preview Document",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/documents/{{document_id}}/preview"
          }
        },
        {
          "name": "Download Document",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/documents/{{document_id}}/download"
          }
        },
        {
          "name": "Delete Document",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/documents/{{document_id}}"
          }
        }
      ]
    },
    {
      "name": "Connectors",
      "item": [
        {
          "name": "Register Connector",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"My Database\",\n    \"type\": \"mysql\",\n    \"config\": {\n        \"host\": \"localhost\",\n        \"port\": 3306,\n        \"database\": \"my_db\",\n        \"username\": \"user\",\n        \"password\": \"pass\"\n    }\n}"
            },
            "url": "{{base_url}}/connectors"
          }
        },
        {
          "name": "List Connectors",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/connectors"
          }
        },
        {
          "name": "Update Connector",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"My Database (Updated)\",\n    \"config\": {\n        \"host\": \"db.example.com\"\n    }\n}"
            },
            "url": "{{base_url}}/connectors/{{connector_id}}"
          }
        },
        {
          "name": "Test Connector",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/connectors/{{connector_id}}/test"
          }
        },
        {
          "name": "Fetch Preview",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"query\": \"SELECT * FROM invoices LIMIT 5\"\n}"
            },
            "url": "{{base_url}}/connectors/{{connector_id}}/fetch-preview"
          }
        },
        {
          "name": "Delete Connector",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/connectors/{{connector_id}}"
          }
        }
      ]
    },
    {
      "name": "Agent & System",
      "item": [
        {
          "name": "Get Agent Version",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/agents/version"
          }
        },
        {
          "name": "Get Fonts",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/fonts"
          }
        }
      ]
    },
    {
      "name": "Formula Editor",
      "item": [
        {
          "name": "Get Formula Functions",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/formula/functions"
          }
        },
        {
          "name": "Validate Formula",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"expression\": \"SUM(items.price * items.qty)\"\n}"
            },
            "url": "{{base_url}}/formula/validate"
          }
        },
        {
          "name": "Evaluate Formula",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"expression\": \"SUM(items.price * items.qty)\",\n    \"context\": {\n        \"items\": [\n            { \"price\": 10000, \"qty\": 3 },\n            { \"price\": 25000, \"qty\": 2 }\n        ]\n    }\n}"
            },
            "url": "{{base_url}}/formula/evaluate"
          }
        }
      ]
    }
  ]
}
