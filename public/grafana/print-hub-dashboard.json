{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source scraping Print Hub /metrics endpoint",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "5.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time Series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "gauge",
      "name": "Gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "barchart",
      "name": "Bar Chart",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "id": null,
  "title": "Print Hub Dashboard",
  "description": "Comprehensive monitoring dashboard for Print Hub print infrastructure. Requires Prometheus datasource scraping the /metrics endpoint.",
  "tags": ["print-hub", "printing", "monitoring"],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "schemaVersion": 36,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Job Throughput",
      "description": "Rate of print jobs over time, broken down by status (success, failed, queued)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(print_hub_jobs_total[5m])",
          "legendFormat": "All Jobs",
          "refId": "A"
        },
        {
          "expr": "rate(print_hub_jobs_total{status=\"success\"}[5m])",
          "legendFormat": "Success",
          "refId": "B"
        },
        {
          "expr": "rate(print_hub_jobs_total{status=\"failed\"}[5m])",
          "legendFormat": "Failed",
          "refId": "C"
        },
        {
          "expr": "rate(print_hub_jobs_total{status=\"queued\"}[5m])",
          "legendFormat": "Queued",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineInterpolation": "smooth",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              { "id": "color", "value": { "fixed": "#ef4444" } }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Success"
            },
            "properties": [
              { "id": "color", "value": { "fixed": "#22c55e" } }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Agent Online / Offline Count",
      "description": "Current count of online vs offline print agents",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "print_hub_agents_online",
          "legendFormat": "Online",
          "refId": "A"
        },
        {
          "expr": "print_hub_agents_offline",
          "legendFormat": "Offline",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineInterpolation": "stepAfter",
            "showPoints": "always"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Queue Depth",
      "description": "Current number of queued print jobs waiting to be processed",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "print_hub_queue_depth",
          "legendFormat": "Queued Jobs",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Failed Jobs Rate",
      "description": "Percentage of print jobs that failed over time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "rate(print_hub_jobs_total{status=\"failed\"}[5m]) / rate(print_hub_jobs_total[5m]) * 100",
          "legendFormat": "Failure Rate %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineInterpolation": "smooth"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 15 }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "hidden"
        }
      }
    },
    {
      "id": 5,
      "title": "Cost Per Day",
      "description": "Total printing cost per day (from print_costs table)",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (branch) (print_hub_cost_per_day{branch=~\".+\"})",
          "legendFormat": "{{branch}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Top Printers by Usage",
      "description": "Printers ranked by total number of jobs processed",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "expr": "topk(10, sort_desc(sum by (printer) (print_hub_jobs_total{printer!=\"\"})))",
          "legendFormat": "{{printer}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "orientation": "horizontal",
        "legend": {
          "displayMode": "list",
          "placement": "right"
        }
      }
    }
  ],
  "rows": [],
  "graph": {},
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ],
    "time_options": [
      "5m",
      "15m",
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d",
      "30d"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "branch",
        "type": "query",
        "query": "label_values(print_hub_jobs_total, branch)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "description": "Filter metrics by branch location"
      },
      {
        "name": "agent",
        "type": "query",
        "query": "label_values(print_hub_agents_online, agent)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "description": "Filter metrics by specific print agent"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "type": "dashboard",
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "showIn": 0
      }
    ]
  }
}
